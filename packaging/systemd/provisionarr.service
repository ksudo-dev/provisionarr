[Unit]
Description=Provisionarr media request service
Documentation=https://github.com/ksudo-dev/provisionarr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=provisionarr
Group=provisionarr
WorkingDirectory=/opt/provisionarr
EnvironmentFile=-/etc/provisionarr/provisionarr.env
Environment=NODE_ENV=production
Environment=PROVISIONARR_CONFIG_ROOT=/var/lib/provisionarr
Environment=PROVISIONARR_REQUEST_LOG=/var/lib/provisionarr/requests.json
Environment=PROVISIONARR_LISTEN_HOST=127.0.0.1
ExecStart=/usr/bin/env node /opt/provisionarr/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/provisionarr
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
UMask=0077

[Install]
WantedBy=multi-user.target
